docxpatch 1

op replace-paragraph
target M.P0001
text Repeated SVG diagram.
end

op insert-image-after
target M.P0001
asset diagram.svg
width 2in
height 1in
alt Public geometric diagram
as diagram
end

op insert-image-after
target M.P0001
asset diagram.svg
width 2in
height 1in
alt Second public diagram
end

op set-image-crop
target @diagram
left-percent 10
right-percent 15
end
