<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>Lokad.OoxPdf</PackageId>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
    <Authors>Lokad</Authors>
    <Company>Lokad</Company>
    <Description>Dependency-free OOXML to PDF renderer for PPTX and DOCX corporate documents.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>0.2.0 improves composed DOCX content, PPTX inheritance and image handling, and simplifies hosting. Breaking API changes require recompiling callers: docs/PublicApiChanges.md. Rendering scope and limitations: docs/PreviewRelease.md. See CHANGELOG.md for release notes.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/Lokad/OoxPDF</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Lokad/OoxPDF.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageOutputPath>..\..\artifacts\nuget\</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\AGENTS.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\docs\*.md" Pack="true" PackagePath="docs/" Visible="false" />
    <None Include="..\..\tests\Lokad.OoxPdf.Tests\Cases\DocxEditInterop\README.md" Pack="true" PackagePath="tests/Lokad.OoxPdf.Tests/Cases/DocxEditInterop/" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>
</Project>
